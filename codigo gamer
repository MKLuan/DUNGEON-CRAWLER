            printf("--- TUTORIAL ---\n\n");
            printf("- Use W, A, S, D para andar.\n");
            printf("- Tecla 'I': Interagir, com NPCs (N), Chaves (@), Portas (D) e Escadas (L).\n");
            printf("- Tecla 'O': Usa a sua arma para destruir Caixas (k) e atacar Inimigos.\n");
            system("pause");
        } 
        else if(escolha != 3) {
            printf("\nOpcao invalida! Digite 1, 2 ou 3.\n");
            system("pause");
