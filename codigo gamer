                        if(faseAtual == 2){
							playerx = 8; playery = 8; 
						}else if(faseAtual == 3){
							playerx = 1; playery = 1; monstro1X = 7; monstro1Y = 3;
						}
                        else if(faseAtual == 4){
							playerx = 1; playery = 5; monstro2X = 12; monstro2Y = 7; bossX = 11; bossY = 18;
						}
                    }
                }
