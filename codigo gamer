                        faseAtual = 3; playerx = 1; playery = 1; playdirecao = 'v'; chavesObtidas = 0; 
                        printf("\n[!] Voce atravessou a porta e desceu para o Segundo Andar da Masmorra!\n"); system("pause");
                    }
                }
                
                int colidiuInimigo = 0;
                if(faseAtual == 3 && playerx == monstro1X && playery == monstro1Y) colidiuInimigo = 1;
                if(faseAtual == 4 && ((playerx == monstro2X && playery == monstro2Y) || (playerx == bossX && playery == bossY))) colidiuInimigo = 1;
                
                if(bloco == '#' || colidiuInimigo) {
