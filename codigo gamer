        printf("------ O JOGO ------\n");
        printf("--- A MASMORRA MALDITA CONTRA O GRANDE HEROI AVENTUREIRO CACADOR DE BESTAS MAGICAS E SALVADOR DE COISAS MASTER PRO DELUXE!! ---\n");
        printf("---[1] INICIAR O GAMER...\n");
        printf("---[2] TUTORIAL (??)\n");
        printf("---[3] SAIR :/ \n\n");
        printf("Escolha: ");
        
        // ---- VALIDAÇÃO 1: MENU PRINCIPAL ----
        if(scanf("%d", &escolha) != 1) {
            int c;
            while ((c = getchar()) != '\n' && c != EOF); 
            escolha = 0; 
        }
        
        if(escolha == 1) {
            char mapa1[10][10] = {
                "**********",
                "****.N.***",
