                else if(faseAtual == 2) bloco = mapa2[proxy][proxx];
                else if(faseAtual == 3) bloco = mapa3[proxy][proxx];
                else if(faseAtual == 4) bloco = mapa4[proxy][proxx];
                
                if(bloco == '.' || bloco == '=' || bloco == '@' || bloco == '#' || bloco == 'O') {
